rules_version = '2';
// Sicherheitsregeln für den Live-Klassenraum aller Themen im WR-Lab.
// - Jeder Raum gehört dem Gerät der Lehrkraft (anonyme Anmeldung), nur sie steuert ihn.
// - Ein Raum gehört zu genau einem Thema (Feld topic), das sich nachträglich nicht ändern lässt.
// - Schüler schreiben nur ihren eigenen Eintrag und sehen nur den Raum, nicht die anderen.
// - Antworten „an die Wand“ sieht nur die Lehrkraft; jeder schreibt nur seine eigenen, solange er im Raum ist.
// - Aus dem Wissenscheck kommen nur Punkte als kurze Zeichenkette (wc), nie Texte.
// - Live-Abstimmung: Die Lehrkraft steuert die Umfrage im Raum, jede Stimme ist eine Zahl im eigenen Eintrag.
// - Klassen-Quiz: Die Lehrkraft steuert das Quiz im Raum (ohne Spitznamen), jede Antwort ist eine Zahl im eigenen Eintrag,
//   nur während die Frage läuft, nur eine pro Frage und mit der Uhrzeit des Servers (für die Punkte nach Tempo).
// - Klassenbank (bank.js): Jeder Teilnehmer hat ein Übungskonto (konten/{IBAN}) mit Spielgeld. Ein Konto findet nur,
//   wer die IBAN kennt (Empfängerprüfung), auflisten darf nur die Lehrkraft. Überweisungen (buchungen) schreibt nur der
//   Absender, höchstens 300 pro Gerät, nur an ein vorhandenes Konto und mit den Namen aus den Konten. Lesen dürfen sie
//   nur Absender, Empfänger und die Lehrkraft. Ändern lässt sich eine Buchung nicht.
// - Räume lassen sich nicht auflisten: Wer keinen Code hat, findet nichts.
// - Alle Felder sind nach Typ und Größe begrenzt, damit niemand die Datenbank vollschreiben kann.
//   Ausnahme im Planspiel: Bei stats (Kennzahlen fürs Dashboard, je Thema verschieden) ist nur die Zahl der Schlüssel
//   begrenzt, nicht Typ und Größe der Werte. Stimmen (votes), Checks und Entscheidungen (choices) sind fest begrenzt.
// - Wer einen Raum, einen Eintrag oder eine Antwort anlegt, setzt ein Ablaufdatum (expireAt, für die TTL-Löschung).
//   Die Obergrenze ist großzügig (72 Stunden), weil der Client mit der Uhr des Geräts rechnet.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function room(code) { return get(/databases/$(database)/documents/rooms/$(code)).data; }
    function isOwner(code) { return signedIn() && room(code).owner == request.auth.uid; }
    // Kürzel für Themen und Figuren: Kleinbuchstaben, Ziffern, Bindestrich
    function isSlug(s, max) { return s is string && s.size() <= max && s.matches('^[a-z0-9-]+$'); }
    function isSmallMap(m) { return m is map && m.size() <= 30; }
    function isTime(t) { return t is timestamp; }
    // Ablaufdatum beim Anlegen: Pflicht, höchstens 72 Stunden in der Zukunft
    function validExpire(d) { return 'expireAt' in d && d.expireAt is timestamp && d.expireAt <= request.time + duration.value(72, 'h'); }
    // Beim Ändern: Ablaufdatum unverändert (auch bei alten Einträgen ohne) oder neu und gültig
    function keepsExpire() {
      return request.resource.data.get('expireAt', null) == resource.data.get('expireAt', null) || validExpire(request.resource.data);
    }

    function validRoom(d) {
      return d.keys().hasOnly(['owner','open','topic','gameId','round','phase','decisions','pause','ziel','zielN','gesperrt','ki','umfrage','quiz','bankMonat','createdAt','expireAt'])
        && d.keys().hasAll(['owner','open','topic','gameId','round','phase','decisions'])
        && d.owner is string
        && d.open is bool
        && isSlug(d.topic, 32)
        && d.gameId is string && d.gameId.size() <= 32
        && d.round is int && d.round >= 0 && d.round <= 30
        && d.phase is string && d.phase.size() <= 20
        && d.decisions is list && d.decisions.size() <= 30
        && (!('pause' in d) || d.pause is bool)
        && (!('ziel' in d) || (d.ziel is string && d.ziel.size() <= 40))
        && (!('zielN' in d) || (d.zielN is int && d.zielN >= 0 && d.zielN <= 100000))
        && (!('gesperrt' in d) || (d.gesperrt is list && d.gesperrt.size() <= 60))
        // Link zum geteilten Lernszenario in AIS.chat (KI-Coach), leer = aus
        && (!('ki' in d) || (d.ki is string && d.ki.size() <= 300 && (d.ki == '' || d.ki.matches('^https://[^ ]+$'))))
        // Live-Abstimmung: id der Aufgabe (leer = keine), Zähler n, auf = aufgedeckt
        && (!('umfrage' in d) || (d.umfrage is map && d.umfrage.keys().hasOnly(['id','n','auf']) && d.umfrage.keys().hasAll(['id','n','auf'])
            && d.umfrage.id is string && (d.umfrage.id == '' || isSlug(d.umfrage.id, 40))
            && d.umfrage.n is int && d.umfrage.n >= 0 && d.umfrage.n <= 100000 && d.umfrage.auf is bool))
        && (!('quiz' in d) || validQuiz(d.quiz))
        // Kontosimulation der Klassenbank: Monat, den die Lehrkraft für alle gestartet hat
        && (!('bankMonat' in d) || (d.bankMonat is int && d.bankMonat >= 0 && d.bankMonat <= 12))
        && (!('createdAt' in d) || isTime(d.createdAt))
        && (!('expireAt' in d) || isTime(d.expireAt));
    }

    // Klassen-Quiz: id des Wissenschecks (leer = keins), n = Durchgang (eine Frage), ph = Phase, i = Aufgabe im Wissenscheck,
    // nr und von = Fortschritt, t = Start der Frage (Serverzeit), s = Sekunden (0 = ohne Zeitlimit), team = Zahl der Teams,
    // pkt = Punkte pro Gerät (Kennung → [gesamt, plus, platz, serie]), teams = Punkte pro Team
    function validQuiz(q) {
      return q is map && q.keys().hasOnly(['id','n','ph','i','nr','von','t','s','team','pkt','teams']) && q.keys().hasAll(['id','n','ph'])
        && q.id is string && (q.id == '' || isSlug(q.id, 40))
        && q.n is int && q.n >= 0 && q.n <= 100000
        && q.ph in ['', 'lobby', 'frage', 'zu', 'auf', 'ende']
        && (!('i' in q) || (q.i is int && q.i >= 0 && q.i < 60))
        && (!('nr' in q) || (q.nr is int && q.nr >= 0 && q.nr <= 60))
        && (!('von' in q) || (q.von is int && q.von >= 0 && q.von <= 60))
        && (!('t' in q) || isTime(q.t))
        && (!('s' in q) || (q.s is int && q.s >= 0 && q.s <= 600))
        && (!('team' in q) || (q.team is int && q.team >= 0 && q.team <= 6))
        && (!('pkt' in q) || (q.pkt is map && q.pkt.size() <= 100))
        && (!('teams' in q) || (q.teams is list && q.teams.size() <= 6));
    }
    // Neue Antwort im Klassen-Quiz: Uhrzeit des Servers, nur während die Frage läuft, nur eine pro Frage
    function neueQuizAntwort(code) {
      let q = request.resource.data.q;
      let alt = resource.data.get('q', null);
      let r = room(code).get('quiz', null);
      return q.at == request.time && r != null && r.ph == 'frage' && q.n == r.n && (alt == null || alt.n != q.n);
    }

    function validPlayer(d) {
      return d.keys().hasOnly(['nick','ort','wc','bk','stimme','q','team','fig','r','ph','votes','checks','choices','stats','joinedAt','updatedAt','expireAt'])
        && d.nick is string && d.nick.size() > 0 && d.nick.size() <= 20
        && (!('ort' in d) || (d.ort is string && d.ort.size() <= 40))
        // Wissenscheck: ein Zeichen pro Aufgabe („-“ offen, „0“–„9“ Zehntel der Punkte, „a“ volle Punkte)
        && (!('wc' in d) || (d.wc is string && d.wc.size() <= 60 && d.wc.matches('^[-0-9a]*$')))
        // Kontosimulation: ein Buchstabe pro Monat („-“ keine Reaktion, „a“ bis „c“ gewählte Reaktion)
        && (!('bk' in d) || (d.bk is string && d.bk.size() <= 12 && d.bk.matches('^[-a-c]*$')))
        // Stimme in der Live-Abstimmung: n = Durchgang, w = Index der Antwort
        && (!('stimme' in d) || (d.stimme is map && d.stimme.keys().hasOnly(['n','w']) && d.stimme.keys().hasAll(['n','w'])
            && d.stimme.n is int && d.stimme.n >= 0 && d.stimme.n <= 100000 && d.stimme.w is int && d.stimme.w >= 0 && d.stimme.w <= 9))
        // Antwort im Klassen-Quiz: n = Durchgang, w = Antwort als Zahl (Index, 1/0, Bitmaske oder Ergebnis), at = Zeitpunkt
        && (!('q' in d) || (d.q is map && d.q.keys().hasOnly(['n','w','at']) && d.q.keys().hasAll(['n','w','at'])
            && d.q.n is int && d.q.n >= 0 && d.q.n <= 100000 && d.q.w is number && d.q.w >= -1000000000000 && d.q.w <= 1000000000000 && isTime(d.q.at)))
        && (!('team' in d) || (d.team is int && d.team >= 0 && d.team <= 6))
        && (!('fig' in d) || isSlug(d.fig, 24))
        && (!('r' in d) || (d.r is int && d.r >= 0 && d.r <= 30))
        && (!('ph' in d) || (d.ph is string && d.ph.size() <= 20))
        // Planspiel, je Runde ein Eintrag: Stimme A, B oder C; Check richtig oder falsch;
        // private Entscheidung als Index der Option (höchstens drei Optionen, siehe planspiel.js)
        && (!('votes' in d) || (isSmallMap(d.votes) && d.votes.values().hasOnly(['A','B','C'])))
        && (!('checks' in d) || (isSmallMap(d.checks) && d.checks.values().hasOnly([true,false])))
        && (!('choices' in d) || (isSmallMap(d.choices) && d.choices.values().hasOnly([0,1,2])))
        && (!('stats' in d) || isSmallMap(d.stats))
        && (!('joinedAt' in d) || isTime(d.joinedAt))
        && (!('updatedAt' in d) || isTime(d.updatedAt))
        && (!('expireAt' in d) || isTime(d.expireAt));
    }

    function validAntwort(d) {
      return d.keys().hasOnly(['uid','aufgabe','text','at','expireAt'])
        && d.uid == request.auth.uid
        && isSlug(d.aufgabe, 40)
        && d.text is string && d.text.size() > 0 && d.text.size() <= 1000
        && isTime(d.at)
        && (!('expireAt' in d) || isTime(d.expireAt));
    }

    function isMember(code) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(code)/players/$(request.auth.uid));
    }
    function konto(code, iban) { return get(/databases/$(database)/documents/rooms/$(code)/konten/$(iban)).data; }
    function validKonto(iban, d) {
      return iban.matches('^DE[0-9]{20}$')
        && d.keys().hasOnly(['uid','name','expireAt'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20;
    }
    // Buchung: Betrag in Cent (1 Cent bis 1.000 €), Namen und Konten müssen zu den Übungskonten passen
    function validBuchung(code, d) {
      return d.keys().hasOnly(['von','an','vonIban','anIban','vonName','anName','betrag','zweck','echtzeit','at','expireAt'])
        && d.von == request.auth.uid
        && d.an is string && d.an != d.von
        && d.vonIban is string && d.vonIban.matches('^DE[0-9]{20}$')
        && d.anIban is string && d.anIban.matches('^DE[0-9]{20}$')
        && d.betrag is int && d.betrag >= 1 && d.betrag <= 100000
        && d.zweck is string && d.zweck.size() <= 140
        && d.echtzeit is bool
        && d.at == request.time
        && konto(code, d.vonIban).uid == request.auth.uid && konto(code, d.vonIban).name == d.vonName
        && konto(code, d.anIban).uid == d.an && konto(code, d.anIban).name == d.anName;
    }

    match /rooms/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.owner == request.auth.uid
        && validRoom(request.resource.data)
        && validExpire(request.resource.data);
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.topic == resource.data.topic
        && validRoom(request.resource.data)
        && keepsExpire();
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /players/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isOwner(code));
        allow list: if isOwner(code);
        allow create: if signedIn() && request.auth.uid == uid
          && room(code).open == true
          && validPlayer(request.resource.data)
          && !('q' in request.resource.data)
          && validExpire(request.resource.data);
        allow update: if signedIn() && request.auth.uid == uid
          && room(code).open == true
          && validPlayer(request.resource.data)
          && (request.resource.data.get('q', null) == resource.data.get('q', null) || neueQuizAntwort(code))
          && keepsExpire();
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(code));
      }

      // Dokument-ID: <uid>_<aufgabe>, also eine Antwort pro Schüler und Aufgabe
      match /antworten/{id} {
        allow get: if signedIn() && (resource.data.uid == request.auth.uid || isOwner(code));
        allow list: if isOwner(code);
        allow create, update: if signedIn()
          && id == request.auth.uid + '_' + request.resource.data.aufgabe
          && room(code).open == true
          && exists(/databases/$(database)/documents/rooms/$(code)/players/$(request.auth.uid))
          && validAntwort(request.resource.data)
          && (resource == null ? validExpire(request.resource.data) : keepsExpire());
        // Löschen: die eigene Antwort („Raum verlassen“) oder als Lehrkraft jede (einzelne Antwort von der Wand nehmen)
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner(code));
      }

      // Klassenbank: Übungskonto, Dokument-ID ist die Übungs-IBAN
      match /konten/{iban} {
        allow get: if isMember(code) || isOwner(code);
        allow list: if isOwner(code);
        allow create: if isMember(code)
          && room(code).open == true
          && validKonto(iban, request.resource.data)
          && validExpire(request.resource.data);
        allow update: if isMember(code)
          && room(code).open == true
          && resource.data.uid == request.auth.uid
          && validKonto(iban, request.resource.data)
          && keepsExpire();
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner(code));
      }

      // Klassenbank: Überweisung, Dokument-ID <uid>_<Nummer 1 bis 300>
      match /buchungen/{id} {
        allow get, list: if signedIn() && (resource.data.von == request.auth.uid || resource.data.an == request.auth.uid || isOwner(code));
        allow create: if isMember(code)
          && room(code).open == true
          && id.matches(request.auth.uid + '_([1-9][0-9]?|[12][0-9][0-9]|300)')
          && validBuchung(code, request.resource.data)
          && validExpire(request.resource.data);
        allow delete: if signedIn() && (resource.data.von == request.auth.uid || isOwner(code));
      }
    }
  }
}
